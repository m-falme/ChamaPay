# Copy to .env and fill in. Never commit .env.
AT_USERNAME=sandbox
AT_API_KEY=
# Leave empty in the sandbox unless you created a sender ID / short code
AT_SENDER_ID=
USSD_CODE=*384*123#
DASHBOARD_PASSWORD=changeme
SECRET_KEY=replace-with-a-long-random-string
PORT=8080
# Optional voice reminders (needs an AT voice number)
VOICE_ENABLED=0
AT_VOICE_NUMBER=
# Optional: defaults to sqlite file chamapay.db in the working directory
# DATABASE_URL=sqlite:////data/chamapay.db
